<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Usage Actual (Final Usage)= Usage Actual (Get Usage Actual) - Usage (Get Usage)</description>
        <name>Final_Usage</name>
        <label>Final Usage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varGetUsageActual</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>varGetUsage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Usage_Actual</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Get_Usage_Actual</name>
        <label>Get Usage Actual</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varGetUsageActual</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Bucket_Detail__r.Usage_Actual__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Usage_from_Triggering_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Get Usage from Triggering Record</description>
        <name>Get_Usage_from_Triggering_Record</name>
        <label>Get Usage from Triggering Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varGetUsage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Final_Usage</targetReference>
        </connector>
    </assignments>
    <description>Delete MST &amp; Update Usage Actual From OrderItem</description>
    <environments>Default</environments>
    <interviewLabel>Delete MST &amp; Update Usage Actual From OrderItem {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Delete MST &amp; Update Usage Actual From OrderItem</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_MST</name>
        <label>Delete MST</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Usage_Actual</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Monthly_Sales_Target__c</elementReference>
            </value>
        </filters>
        <object>Monthly_Sales_Target__c</object>
    </recordDeletes>
    <recordUpdates>
        <name>Update_Usage_Actual</name>
        <label>Update Usage Actual</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Bucket_Detail__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Usage_Actual__c</field>
            <value>
                <elementReference>varGetUsageActual</elementReference>
            </value>
        </inputAssignments>
        <object>OrderItem</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Delete_MST</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Monthly_Sales_Target__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Usage__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varGetUsage</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <description>get usage actual from parent (OrderItem)</description>
        <name>varGetUsageActual</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
