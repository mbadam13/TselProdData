            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Proposal_Activity__c</field>
            <value>
                <elementReference>incrementValueProposalAcitity</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
