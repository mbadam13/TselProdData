        <expression>IF(ISBLANK({!getRecordOppty.Proposal_Activity__c}), 1, {!getRecordOppty.Proposal_Activity__c} + 1)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Opportunity Stamping Count of Proposal and Meeting Activity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Stamping Count of Proposal and Meeting Activity</label>
    <processMetadataValues>
