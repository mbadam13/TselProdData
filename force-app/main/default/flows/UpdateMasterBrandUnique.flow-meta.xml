<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>52.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Hyphen</name>
        <dataType>String</dataType>
        <value>
            <stringValue>-</stringValue>
        </value>
    </constants>
    <description>Ver.1 + add filter for Mustika Indonesia as record creator only</description>
    <formulas>
        <name>FormulaUniqueID</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name}+{!Hyphen}+{!$Record.Media_Seller__r.Name}</expression>
    </formulas>
    <interviewLabel>UpdateMasterBrandUnique {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UpdateMasterBrandUnique</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>UpdateMasterBrandID</name>
        <label>UpdateMasterBrandID</label>
        <locationX>176</locationX>
        <locationY>295</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedById</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.UserId_MustikaIndonesia</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Master_Brand_Unique_ID__c</field>
            <value>
                <elementReference>FormulaUniqueID</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>UpdateMasterBrandID</targetReference>
        </connector>
        <object>Master_Brand__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
