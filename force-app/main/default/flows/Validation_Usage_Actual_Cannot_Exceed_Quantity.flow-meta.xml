<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>get_Campaign_Id</name>
        <label>get Campaign Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCampaignId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Campaign_ID__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_Usage_Amount_c</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>get_Quantity_OrderItem</name>
        <label>get Quantity OrderItem</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varQuantity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Bucket_Detail__r.Quantity</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Usage_CSV_Value_Check</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>get_Usage</name>
        <label>get Usage Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varUsageId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_Campaign_Id</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>get_Usage_Actual</name>
        <label>get Usage Actual</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varUsageActual</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Bucket_Detail__r.Usage_Actual__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_Quantity_OrderItem</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>get_Usage_Amount_c</name>
        <label>get Usage (Amount__c)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varUsageAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_Usage_Actual</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Total_Usage</name>
        <label>Total Usage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotalUsage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varUsageActual</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Usage_Acumulations_Check</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Usage_Acumulations</name>
        <label>Usage Accumulations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varUsageActual</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varUsageAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Total_Usage</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Copy_1_of_Error_Message_1</name>
        <label>Error Message 2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Total atau akumulasi usage tidak boleh melebihi quantity order product - No Campaign Id:  {!$Record.Campaign_ID__c}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Error_Message_1</name>
        <label>Error Message 1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Usage_Acumulations</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>Usage tidak boleh melebihi quantity order product - No Campaign Id:  {!$Record.Campaign_ID__c}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Usage_Acumulations_Check</name>
        <label>Usage Accumulations Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Acumulations_Over_QTY</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotalUsage</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varQuantity</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Error_Message_1</targetReference>
            </connector>
            <label>If Accumulations Over QTY?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Usage_CSV_Value_Check</name>
        <label>Usage CSV Value Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Usage_Acumulations</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Usage_Qty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varQuantity</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message_1</targetReference>
            </connector>
            <label>If Usage &gt; Qty</label>
        </rules>
    </decisions>
    <decisions>
        <name>Usage_Value_Cek</name>
        <label>Usage Value Cek</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Usag</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Amount__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_Usage</targetReference>
            </connector>
            <label>If Usage Change</label>
        </rules>
    </decisions>
    <description>v2: fix impact dari trigger lain</description>
    <environments>Default</environments>
    <interviewLabel>Can {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Validation - Usage Actual Cannot Exceed Quantity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Usage_Value_Cek</targetReference>
        </connector>
        <object>Usage__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCampaignId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varQuantity</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varTotalUsage</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varUsageActual</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varUsageAmount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varUsageId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
