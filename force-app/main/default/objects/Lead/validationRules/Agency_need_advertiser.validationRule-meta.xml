<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Agency_need_advertiser</fullName>
    <active>false</active>
    <description>Agency_need_advertiser</description>
    <errorConditionFormula>AND(
ISBLANK( Advertiser_Name__c ),
TEXT(Account_Type__c ) = &quot;Agency&quot;,
ISPICKVAL( Status, &quot;Qualified&quot;)
)</errorConditionFormula>
    <errorMessage>Agency need advertiser</errorMessage>
</ValidationRule>
