<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_Phone_name_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
   ISBLANK(Email),
   OR(ISBLANK( Phone )),
   OR(ISBLANK(MobilePhone))
)</errorConditionFormula>
    <errorMessage>Email or Phone or Mobile Cannot Blank</errorMessage>
</ValidationRule>
