<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Number_of_Day__c</fullName>
    <description>dibuat untuk kebutuhan report MTD agar apple to apple antara actual dan target</description>
    <externalId>false</externalId>
    <formula>CASE(
MONTH(TODAY()),
1, 31,
2, IF(
OR(
MOD(YEAR(TODAY()), 400) = 0,
AND(
MOD(YEAR(TODAY()), 100) &lt;&gt; 0,
MOD(YEAR(TODAY()), 4) = 0
)
), 29, 28
),
3, 31,
4, 30,
5, 31,
6, 30,
7, 31,
8, 31,
9, 30,
10, 31,
11, 30,
12, 31,
0
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Number of Day</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
