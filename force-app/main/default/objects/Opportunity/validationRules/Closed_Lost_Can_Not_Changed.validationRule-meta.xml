<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Lost_Can_Not_Changed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(PRIORVALUE(StageName), &apos;Closed Lost&apos;), ISCHANGED(StageName) )</errorConditionFormula>
    <errorMessage>Opportunity Already Closed Lost</errorMessage>
</ValidationRule>
