<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fill_Brand_Validation</fullName>
    <active>false</active>
    <description>AND(
   ISPICKVAL(StageName,&apos;Visit / Call&apos;),
   ISBLANK(Brand__c) 
)
brand harus di isi untuk sales dan sales manager</description>
    <errorConditionFormula>AND(
ISCHANGED(StageName),
(ISBLANK( Brand__c )),
$Profile.Name = &quot;Sales&quot; || $Profile.Name = &quot;Sales Manager&quot;
)</errorConditionFormula>
    <errorMessage>Please fill Brand.</errorMessage>
</ValidationRule>
