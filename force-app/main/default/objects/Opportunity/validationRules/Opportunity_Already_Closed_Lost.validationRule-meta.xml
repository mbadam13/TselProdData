<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opportunity_Already_Closed_Lost</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( StageName , &apos;Closed Lost&apos;) , 
ISBLANK(TEXT(Loss_Reason__c)) 
)</errorConditionFormula>
    <errorDisplayField>Loss_Reason__c</errorDisplayField>
    <errorMessage>Please put Reason first for Closed Lost Opportunity</errorMessage>
</ValidationRule>
