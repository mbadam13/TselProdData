<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_for_Back_Stage</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
   ISCHANGED(StageName),
   TEXT(PRIORVALUE(StageName)) = &apos;Closed Won&apos;, 
   TEXT(StageName) != &apos;Negotiation&apos;
)</errorConditionFormula>
    <errorMessage>Please back stage to Negotiation.</errorMessage>
</ValidationRule>
