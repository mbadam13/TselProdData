<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_for_Send_Proposal</fullName>
    <active>true</active>
    <description>Validation_for_Send_Proposal</description>
    <errorConditionFormula>AND( ISPICKVAL(StageName,&apos;Send Proposal&apos;),NOT(ISPICKVAL( Request_for_Proposal_Status__c,&apos;Completed&apos;)) )</errorConditionFormula>
    <errorDisplayField>RFP_Status__c</errorDisplayField>
    <errorMessage>Proposal has not completed</errorMessage>
</ValidationRule>
