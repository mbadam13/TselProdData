<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_rule_Proposal_v2</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(StageName , &quot;Proposal / PO Sign&quot;), 
NOT(ISPICKVAL(Approval_Status__c , &quot;Approved&quot;))
)</errorConditionFormula>
    <errorMessage>Negotiation has not approved</errorMessage>
</ValidationRule>
