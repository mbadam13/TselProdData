<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_rule_for_Quotation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL( StageName , &quot;Proposal&quot;), NOT(ISPICKVAL(  Approval_Status__c , &quot;Approved&quot;)))</errorConditionFormula>
    <errorDisplayField>Approval_Status__c</errorDisplayField>
    <errorMessage>Negotiation has not approved</errorMessage>
</ValidationRule>
