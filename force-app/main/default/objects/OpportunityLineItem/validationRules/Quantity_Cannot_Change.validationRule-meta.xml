<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantity_Cannot_Change</fullName>
    <active>true</active>
    <errorConditionFormula>AND (ISPICKVAL( Opportunity.StageName , &apos;Closed Won&apos;),ISCHANGED(Quantity))</errorConditionFormula>
    <errorDisplayField>Quantity</errorDisplayField>
    <errorMessage>quantity cannot changed, after closed won</errorMessage>
</ValidationRule>
