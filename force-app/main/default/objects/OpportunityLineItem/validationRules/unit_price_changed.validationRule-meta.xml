<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>unit_price_changed</fullName>
    <active>true</active>
    <description>unit_price_changed</description>
    <errorConditionFormula>AND (ISPICKVAL( Opportunity.StageName , &apos;Closed Won&apos;),ISCHANGED(UnitPrice))</errorConditionFormula>
    <errorDisplayField>UnitPrice</errorDisplayField>
    <errorMessage>cannot change sales price, after closed won</errorMessage>
</ValidationRule>
