<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Product_Cannot_Change</fullName>
    <active>false</active>
    <description>Product cannot change != draft</description>
    <errorConditionFormula>AND(ISCHANGED(Product__c),ONB_Status__c!=&apos;Draft&apos;)</errorConditionFormula>
    <errorDisplayField>Product__c</errorDisplayField>
    <errorMessage>Product Cannot Change</errorMessage>
</ValidationRule>
