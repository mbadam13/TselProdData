<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantity_Cannot_Change</fullName>
    <active>true</active>
    <description>Quantity_Cannot_Change != draft</description>
    <errorConditionFormula>AND(ISCHANGED(Quantity__c),ONB_Status__c!=&apos;Draft&apos;)</errorConditionFormula>
    <errorDisplayField>Quantity__c</errorDisplayField>
    <errorMessage>Quantity cannot Change</errorMessage>
</ValidationRule>
