<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Attachment_Link</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(  Request_for_Proposal_Status__c  , &quot;Completed&quot;),  ISBLANK(  Attachment__c ))</errorConditionFormula>
    <errorDisplayField>Attachment__c</errorDisplayField>
    <errorMessage>Attachment Link must fill</errorMessage>
</ValidationRule>
