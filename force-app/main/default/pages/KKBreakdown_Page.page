<apex:page standardController="Kertas_Kerja__c" extensions="KKBreakdown_Controller">
    <style type="text/css">
        .htable {
            font-size: 12px;
            text-align: center;
            border-top: 1.5px solid #a39e9e;
            border-bottom: 1.5px solid #a39e9e;
        }
        .TableRow {
            font-size: 10px;
            border-top: 0.5px solid #a39e9e;
            padding: 2px;
        }
    </style>
    <apex:form >
        <!--<apex:pageBlock title="KK Breakdown">-->
        <apex:pageBlock >
            <table width="100%" border="0">
                <tr>
                    <td colspan="3"></td>
                    <td width="1%" rowspan="5" style="background: #483D8B;"></td>
                    <td colspan="2"></td>
                </tr>
                <tr>
                    <td width="5%"></td>
                    <td width="15%">Product</td>
                    <td width="35%"><apex:inputText value="{!productName}"/></td>
                    
                    <td width="4%"></td>
                    <td width="40%" rowspan="2" style="text-align: center;"><apex:commandButton value="Insert Buffer" action="{!insertBuffer_KKSum}"/></td>
                </tr>
                <tr>
                    <td></td>
                    <td>Order No.</td>
                    <td><apex:inputText value="{!orderNo}"/></td>
                    <td></td>
                </tr>
                <tr>
                    <td></td>
                    <td colspan="2" style="text-align: center;">
                        <apex:commandButton value="Search" action="{!getKKBreakdownRecs}"/>
                    </td>
                    <td></td>
                    <td style="text-align: center;">Insert Buffer Timestamp: {!str_bufferTimestamp}</td>
                </tr>
                <tr>
                    <td colspan="3"></td>
                    <td colspan="2"></td>
                </tr>
            </table>
            <!--<apex:inputText value="{!productName}">Product &nbsp;</apex:inputText><br/><br/>
            <apex:inputText value="{!orderNo}">Order No. &nbsp;</apex:inputText><br/><br/>
            <apex:commandButton value="Search" action="{!getKKBreakdownRecs}"/>-->
        </apex:pageBlock>
        <apex:pageMessages />
        <apex:pageBlock title="Summary" rendered="{!st_display}">
            <apex:pageBlockTable value="{!swList}" var="sw" width="100%">
                <!--<apex:column value="{!sw.wOrderNumber}" headerValue="Order No." styleClass="TableRow" headerClass="htable" style="text-align: center;"/>-->
                <apex:column value="{!sw.wRemark}" headerValue="Remark" styleClass="TableRow" headerClass="htable" style="text-align: center;" width="25%"/>
                <apex:column value="{!sw.wStartDate}" headerValue="Start Date" styleClass="TableRow" headerClass="htable" style="text-align: center;" width="15%"/>
                <apex:column value="{!sw.wEndDate}" headerValue="End Date" styleClass="TableRow" headerClass="htable" style="text-align: center;" width="15%"/>
                <apex:column headerValue="Pembelian" styleClass="TableRow" headerClass="htable" style="text-align: right;padding-right: 10px;" width="15%">
                    <apex:outputText value="{0, number,#,##0.00}">
                        <apex:param value="{!sw.wPembelian}"/>
                    </apex:outputText>
                </apex:column>
                
                
                <apex:column headerValue="Penggunaan" styleClass="TableRow" headerClass="htable" style="text-align: right;padding-right: 10px;" width="15%">
                    <apex:outputText value="{0, number,#,##0.00}">
                        <apex:param value="{!sw.wPenggunaan}"/>
                    </apex:outputText>
                </apex:column>
                <apex:column headerValue="Saldo" styleClass="TableRow" headerClass="htable" style="text-align: right;padding-right: 10px;" width="15%">
                    <apex:outputText value="{0, number,#,##0.00}">
                        <apex:param value="{!sw.wSaldo}"/>
                    </apex:outputText>
                </apex:column>
            </apex:pageBlockTable>
        </apex:pageBlock>
        <apex:pageBlock title="Breakdown" rendered="{!bt_display}">
            <apex:pageBlockTable value="{!bwList}" var="bw" width="100%">
                <!--<apex:column value="{!bw.wOrderNumber}" headerValue="Order No." styleClass="TableRow" headerClass="htable" style="text-align: center;"/>-->
                <apex:column value="{!bw.wRemark}" headerValue="Remark" styleClass="TableRow" headerClass="htable" style="text-align: center;"/>
                <apex:column value="{!bw.wDate}" headerValue="Date" styleClass="TableRow" headerClass="htable" style="text-align: center;"/>
                <apex:column value="{!bw.wType}" headerValue="Type" styleClass="TableRow" headerClass="htable" style="text-align: center;"/>
                <apex:column headerValue="Quantity" styleClass="TableRow" headerClass="htable" style="text-align: right; padding-right: 10px;">
                    <apex:outputText value="{0, number,#,##0.00}">
                        <apex:param value="{!bw.wQty}"/>
                    </apex:outputText>
                </apex:column>
            </apex:pageBlockTable>
        </apex:pageBlock>
    </apex:form> 
</apex:page>