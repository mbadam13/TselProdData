<apex:page standardController="Kertas_Kerja__c" extensions="KKDetailview_Controller" docType="html-5.0">
    <style type="text/css">
        .htable {
        font-size: 12px;
        text-align: center;
        border-top: 1.5px solid #a39e9e;
        border-bottom: 1.5px solid #a39e9e;
        }
        .TableRow {
        font-size: 10px;
        border-top: 0.5px solid #a39e9e;
        padding: 2px;
        }
    </style>
    
    <apex:form >
        <apex:pageBlock title="Add / Edit KKD" rendered="{!displayInputSection}">
            
            <apex:pageBlockSection columns="2" id="sectioncreate">                   
                <!--<apex:inputField id="Media_Seller__c" label="Media Seller" value="{!KKDrec.Media_Seller__c}"  required="true"/> <!--Media seller tidak perlu input, nanti lgs assign dari kk.MediaSeller aja di controller-->
                <apex:outputText id="MediaSeller" label="Media Seller" value="{!kkRec.Media_Seller_Name__c}"></apex:outputText>
                <apex:inputField id="KKDName" label="Name" value="{!KKDrec.Kertas_Kerja_Detail_Name__c}"/> 
                <apex:inputField id="KKDStartDate" label="Start Date" value="{!KKDrec.Start_Date__c}"/>
                <apex:inputField id="KKDType" label="Type" value="{!KKDrec.Type__c}"/>           
                <apex:inputField id="KKDEndDate" label="End Date" value="{!KKDrec.End_Date__c}"/>
                <apex:input label="Amount" value="{!amounttemp}"/>               
            </apex:pageBlockSection>
            
            <table width="100%" border="0">
                <tr>
                    <td style="text-align: right; padding-right: 0px;" width="50%">
                        <apex:commandbutton value="Save" action="{!createkkd}"  />
                        <apex:param value="{!KKDrec.id}" name="Id"  />
                    </td>
                    <td style="text-align: left; padding-left: 0px;">
                        <apex:commandbutton value="Cancel" action="{!cancelButton}"/>
                    </td>
                </tr>
            </table>
            
        </apex:pageBlock>
        
        <apex:pageMessages />
    </apex:form>
    
    <apex:form >
        <apex:pageBlock id="KKDlistview" mode="edit"  >
            <table width="100%">
                <tr>
                    <td style="font-size: 18px;"><b>&nbsp;Kertas Kerja Detail</b></td>
                    <td style="text-align: right; padding-right: 25px; padding-bottom: 10px; padding-top: 10px">
                        <apex:commandbutton value="Add" action="{!addButton}"/>
                    </td>
                </tr>
            </table>
            
            <apex:pageBlockTable value="{!kkdw_list}" var="dw" width="100%" >
                <!--<apex:column value="{!dw.wkkdId}" headerValue="ID." styleClass="TableRow" headerClass="htable" style="text-align: center;"/>-->
                <apex:column value="{!dw.wStartDate}"  rendered="true" headerValue="Start Date" styleClass="TableRow" headerClass="htable" style="text-align: center;" width="12.5%%"/>
                <apex:column value="{!dw.wEndDate}" rendered="true"  headerValue="End Date" styleClass="TableRow" headerClass="htable" style="text-align: center;" width="12.5%%"/>
                <apex:column value="{!dw.wRemark}" rendered="true"  headerValue="Remark" styleClass="TableRow" headerClass="htable" style="text-align: left;" width="30%"/>                
                <apex:column headerValue="Pembelian"  rendered="true" styleClass="TableRow" headerClass="htable" style="text-align: right;" width="15%">
                    <apex:outputText value="{0, number,#,##0.00}">
                        <apex:param value="{!dw.wPembelian}"/>
                    </apex:outputText>
                </apex:column>               
                <apex:column headerValue="Penggunaan"  rendered="true" styleClass="TableRow" headerClass="htable" style="text-align: right;" width="15%">
                    <apex:outputText value="{0, number,#,##0.00}">
                        <apex:param value="{!dw.wPenggunaan}"/>
                    </apex:outputText>
                </apex:column>                
                <apex:column headerValue="Saldo"  rendered="true" styleClass="TableRow" headerClass="htable" style="text-align: right;" width="15%">
                    <apex:outputText value="{0, number,#,##0.00}">
                        <apex:param value="{!dw.wSaldo}"/>
                    </apex:outputText>
                </apex:column>                
                <apex:column HeaderValue="Action" width="80" style="text-align: center;">  
                    <apex:commandLink value="Edit" action="{!EdittheSection}" style="color:#015ba7" >
                        <apex:param value="{!dw.wkkdId}" assignTo="{!KKD_ID}" name="Id"/> 
                    </apex:commandLink>
                </apex:column>     
                
            </apex:pageBlockTable>
        </apex:pageBlock>
        
    </apex:form> 
</apex:page>