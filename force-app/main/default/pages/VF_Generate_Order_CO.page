                      </td>
                     <td id="IOM" >
                         <apex:outputText value="{!string.Impression_Click__c}" id="Impression_Click__c"/><br/>
                     </td>
                     <td id="IOM" >
                         <apex:outputText value="{!string.SMS_Per_Day_Location__c}" id="SMS_Per_Day_Location__c"/><br/>
                     </td>
                      <td id="IOM">
                        <apex:outputText value="{!string.WORDING_PICTURE_VIDEO__c}" id="WORDING_PICTURE_VIDEO__c"/><br/>
                     </td>
                     <td id="IOM">
                        <apex:outputText value="{!string.Placement__c}" id="Placement__c"/><br/>
                     </td>
                 </tr>
                 </apex:repeat>
         </table>
         </apex:form>
            <table width="100%">
