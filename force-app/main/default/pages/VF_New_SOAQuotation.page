<apex:page StandardController="SOA__c" extensions="SOAQuotationController">
<apex:form >
  <apex:pageBlock title="Quotation">
      <apex:pageBlockSection title="Section" columns="2">
          <apex:inputField value="{!QuoteRec.Name}"/>
          <apex:inputField value="{!QuoteRec.ExpirationDate}"/>
          <apex:inputField value="{!QuoteRec.Start_Date__c}"/>
          <apex:inputField value="{!QuoteRec.End_Date__c}"/>
          <!--<apex:inputField value="{!QuoteRec.Opportunity}"/>
          <apex:inputField value="{!QuoteRec.soa__c}"/>-->
      </apex:pageBlockSection>
      <apex:pageBlockButtons >
          <apex:commandButton action="{!save}" value="Save"/>
          <apex:commandButton action="{!back}" value="Cancel"/>
      </apex:pageBlockButtons>
  </apex:pageBlock>
</apex:form>
</apex:page>