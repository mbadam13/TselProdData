    <rules>
        <fullName>Close won notification</fullName>
        <active>false</active>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Closed Won</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Status_Proposal__c</field>
            <operation>equals</operation>
            <value>OK</value>
        </criteriaItems>
        <description>Notify to AM when Opportunity Close won for the next step</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
