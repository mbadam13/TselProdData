    <rules>
        <fullName>Auto RFP assign</fullName>
        <actions>
            <name>RFP_Assign</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Request_for_proposal__c.OwnerId</field>
            <operation>notEqual</operation>
            <value>Marketing Queue</value>
        </criteriaItems>
        <criteriaItems>
            <field>Request_for_proposal__c.Request_for_Proposal_Status__c</field>
            <operation>equals</operation>
            <value>Request</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
